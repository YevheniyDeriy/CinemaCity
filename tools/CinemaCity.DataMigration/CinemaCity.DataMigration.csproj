<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../backend/CinemaCity.AuthService/CinemaCity.AuthService.csproj" />
    <ProjectReference Include="../../backend/CinemaCity.CatalogService/CinemaCity.CatalogService.csproj" />
    <ProjectReference Include="../../backend/CinemaCity.Infrastructure/CinemaCity.Infrastructure.csproj" />
  </ItemGroup>
  <!-- This offline tool reads connections from the environment, not service appsettings. -->
  <Target Name="ExcludeServiceSettingsFromPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('appsettings')) and '%(ResolvedFileToPublish.Extension)' == '.json'" />
    </ItemGroup>
  </Target>
</Project>
