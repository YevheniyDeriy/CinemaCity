{
  "Gateway": {
    "Mode": "Services",
    "BaseUrl": "http://localhost:5000",
    "RoutesFile": "ocelot.json",
    "TimeoutSeconds": 8,
    "CacheTtlSeconds": 60,
    "Limits": {
      "login": 5,
      "anonymous": 120,
      "user": 240,
      "WindowSeconds": 60
    }
  },
  "Services": {
    "MonolithUrl": "http://localhost:5100",
    "AuthUrl": "http://localhost:5001",
    "CatalogUrl": "http://localhost:5002",
    "CommunityUrl": "http://localhost:5003"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5174"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Ocelot": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "CinemaCity",
    "Audience": "CinemaCity.Client"
  }
}